---
import '../styles/global.css';
import { factions } from '../data/factions';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/img/banner.webp', Astro.site);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Animals City" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
  </head>
  <body>
    <a class="skip-link" href="#main">Saltar al contenido</a>

    <header class="site-header">
     <div class="header-inner">
      <a class="brand-link" href="/">
        <img src="/img/logo.webp" width="48" height="48" alt="Escudo de Animals City" />
        <div class="brand-text">
          <strong>Animals City</strong>
          <span>Código Normativo</span>
        </div>
      </a>

      <nav class="main-nav">
        <details class="nav-dropdown" id="expedientes-dd">
          <summary>
            Expedientes
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="dropdown-panel">
            {factions.map((f) => (
              <a class="dropdown-item" href={`/${f.slug}/`} aria-current={currentPath === `/${f.slug}` ? 'page' : undefined}>
                {f.badge ? (
                  <span class="dd-badge"><img src={f.badge} alt="" width="56" height="56" loading="lazy" /></span>
                ) : (
                  <span class="dd-chip" style={`background:var(${f.colorVar})`}>{f.code}</span>
                )}
                <span class="dd-text">
                  <strong>{f.title}</strong>
                  <small>{f.blurb}</small>
                </span>
              </a>
            ))}
          </div>
        </details>
      </nav>

      <div class="search-box">
        <input id="search" type="search" placeholder="Buscar en toda la normativa…" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="search-results" aria-autocomplete="list" />
        <div class="search-results" id="search-results" hidden></div>
      </div>
     </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src="/img/logo.webp" width="32" height="32" alt="" />
        <div>
          <strong>Animals City</strong>
          <span>Código Normativo · Ed. 2025</span>
        </div>
      </div>

      <nav class="footer-nav">
        <a href="/">Portada</a>
        {factions.map((f) => <a href={`/${f.slug}/`}>{f.title}</a>)}
      </nav>

      <div class="footer-legal">
        <span>USO EXCLUSIVO ANIMALS CITY RP · © 2025 TODOS LOS DERECHOS RESERVADOS</span>
        <span>Contenido reorganizado a partir de la <a href="https://sites.google.com/view/normativaanimalscity/inicio/" target="_blank" rel="noopener">normativa oficial</a></span>
      </div>
    </footer>

    <script>
      interface ClauseEntry {
        slug: string;
        pageTitle: string;
        code: string;
        colorVar: string;
        id: string;
        clauseNum: string;
        title: string;
        text: string;
      }

      const searchInput = document.getElementById('search') as HTMLInputElement | null;
      const resultsBox = document.getElementById('search-results') as HTMLDivElement | null;

      if (searchInput && resultsBox) {
        let indexData: ClauseEntry[] | null = null;
        let indexPromise: Promise<ClauseEntry[]> | null = null;
        let debounceId: ReturnType<typeof setTimeout>;
        let activeIndex = -1;

        function loadIndex(): Promise<ClauseEntry[]> {
          if (indexPromise) return indexPromise;
          indexPromise = fetch('/search-index.json')
            .then((r) => r.json())
            .then((data: ClauseEntry[]) => {
              indexData = data;
              return data;
            })
            .catch(() => []);
          return indexPromise;
        }

        function escapeHtml(s: string): string {
          return s.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));
        }

        function snippetAround(text: string, needle: string, radius = 60): string {
          const idx = text.toLowerCase().indexOf(needle);
          if (idx === -1) return text.slice(0, radius * 2);
          const start = Math.max(0, idx - radius);
          const end = Math.min(text.length, idx + needle.length + radius);
          let s = text.slice(start, end);
          if (start > 0) s = '…' + s;
          if (end < text.length) s += '…';
          return s;
        }

        function highlight(text: string, needle: string): string {
          const escaped = escapeHtml(text);
          const re = new RegExp('(' + needle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
          return escaped.replace(re, '<mark>$1</mark>');
        }

        function closeResults() {
          resultsBox!.hidden = true;
          resultsBox!.innerHTML = '';
          searchInput!.setAttribute('aria-expanded', 'false');
          activeIndex = -1;
        }

        function renderResults(matches: ClauseEntry[], q: string) {
          if (matches.length === 0) {
            resultsBox!.innerHTML = '<div class="search-empty">Sin resultados para "' + escapeHtml(q) + '".</div>';
            resultsBox!.hidden = false;
            searchInput!.setAttribute('aria-expanded', 'true');
            return;
          }
          resultsBox!.innerHTML = matches
            .map((m, i) => {
              const snippet = highlight(snippetAround(m.text, q), q);
              return (
                '<a class="search-result" href="/' + m.slug + '/#' + m.id + '" data-index="' + i + '">' +
                '<span class="sr-chip" style="background:var(' + m.colorVar + ')">' + escapeHtml(m.code) + '</span>' +
                '<span class="sr-body">' +
                '<span class="sr-head"><strong>' + escapeHtml(m.title) + '</strong><small>' + escapeHtml(m.pageTitle) + ' · ' + escapeHtml(m.clauseNum) + '</small></span>' +
                '<span class="sr-snippet">' + snippet + '</span>' +
                '</span>' +
                '</a>'
              );
            })
            .join('');
          resultsBox!.hidden = false;
          searchInput!.setAttribute('aria-expanded', 'true');
        }

        function runSearch(q: string) {
          if (!q) {
            closeResults();
            return;
          }
          loadIndex().then((data) => {
            const needle = q.toLowerCase();
            const scored = data
              .map((entry) => {
                const titleHit = entry.title.toLowerCase().includes(needle);
                const textHit = entry.text.toLowerCase().includes(needle);
                if (!titleHit && !textHit) return null;
                return { entry, score: titleHit ? 2 : 1 };
              })
              .filter((x): x is { entry: ClauseEntry; score: number } => x !== null)
              .sort((a, b) => b.score - a.score)
              .slice(0, 8)
              .map((x) => x.entry);
            renderResults(scored, q);
          });
        }

        searchInput.addEventListener('input', () => {
          clearTimeout(debounceId);
          const q = searchInput!.value.trim();
          debounceId = setTimeout(() => runSearch(q), 150);
        });

        searchInput.addEventListener('focus', () => {
          if (searchInput!.value.trim()) runSearch(searchInput!.value.trim());
        });

        searchInput.addEventListener('keydown', (e) => {
          const items = Array.from(resultsBox!.querySelectorAll('.search-result')) as HTMLAnchorElement[];
          if (e.key === 'Escape') {
            closeResults();
          } else if (e.key === 'ArrowDown' && items.length) {
            e.preventDefault();
            activeIndex = Math.min(activeIndex + 1, items.length - 1);
            items[activeIndex].focus();
          } else if (e.key === 'ArrowUp' && items.length) {
            e.preventDefault();
            activeIndex = Math.max(activeIndex - 1, 0);
            items[activeIndex].focus();
          }
        });

        document.addEventListener('click', (e) => {
          if (!resultsBox!.hidden && !resultsBox!.contains(e.target as Node) && e.target !== searchInput) {
            closeResults();
          }
        });
      }

      const dropdown = document.getElementById('expedientes-dd') as HTMLDetailsElement | null;
      if (dropdown) {
        document.addEventListener('click', (e) => {
          if (dropdown.open && !dropdown.contains(e.target as Node)) {
            dropdown.open = false;
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && dropdown.open) {
            dropdown.open = false;
          }
        });
      }
    </script>
  </body>
</html>
