---
import '../styles/global.css';
import { factions } from '../data/factions';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand-link" href="/">
        <img src="/img/logo.webp" width="40" height="40" alt="Escudo de Animals City" />
        <div class="brand-text">
          <strong>Animals City</strong>
          <span>Código Normativo</span>
        </div>
      </a>

      <nav class="main-nav">
        <a class="nav-link" href="/" aria-current={currentPath === '/' ? 'page' : undefined}>Portada</a>

        <details class="nav-dropdown" id="expedientes-dd">
          <summary>
            Expedientes
            <svg class="chevron" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="dropdown-panel">
            {factions.map((f) => (
              <a class="dropdown-item" href={`/${f.slug}/`} aria-current={currentPath === `/${f.slug}` ? 'page' : undefined}>
                {f.badge ? (
                  <span class="dd-badge"><img src={f.badge} alt="" width="56" height="56" loading="lazy" /></span>
                ) : (
                  <span class="dd-chip" style={`background:var(${f.colorVar})`}>{f.code}</span>
                )}
                <span class="dd-text">
                  <strong>{f.title}</strong>
                  <small>{f.blurb}</small>
                </span>
              </a>
            ))}
          </div>
        </details>
      </nav>

      <div class="search-box">
        <input id="search" type="search" placeholder="Buscar en esta página…" autocomplete="off" />
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-brand">
        <img src="/img/logo.webp" width="32" height="32" alt="" />
        <div>
          <strong>Animals City</strong>
          <span>Código Normativo · Ed. 2025</span>
        </div>
      </div>

      <nav class="footer-nav">
        <a href="/">Portada</a>
        {factions.map((f) => <a href={`/${f.slug}/`}>{f.title}</a>)}
      </nav>

      <div class="footer-legal">
        <span>USO EXCLUSIVO ANIMALS CITY RP · © 2025 TODOS LOS DERECHOS RESERVADOS</span>
        <span>Contenido reorganizado a partir de la <a href="https://sites.google.com/view/normativaanimalscity/inicio/" target="_blank" rel="noopener">normativa oficial</a></span>
      </div>
    </footer>

    <script>
      const searchInput = document.getElementById('search') as HTMLInputElement | null;
      if (searchInput) {
        let debounceId: ReturnType<typeof setTimeout>;

        function clearSearch() {
          document.querySelectorAll('.clause').forEach((c) => {
            c.classList.remove('hidden-by-search');
            c.querySelectorAll('mark').forEach((m) => {
              const parent = m.parentNode;
              if (!parent) return;
              parent.replaceChild(document.createTextNode(m.textContent || ''), m);
              parent.normalize();
            });
          });
        }

        function runSearch(q: string) {
          clearSearch();
          if (!q) return;
          const needle = q.toLowerCase();
          const re = new RegExp('(' + q.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');

          document.querySelectorAll('.clause').forEach((clause) => {
            const text = (clause.textContent || '').toLowerCase();
            if (text.indexOf(needle) === -1) {
              clause.classList.add('hidden-by-search');
            } else {
              clause.querySelectorAll('h3, p, li, blockquote').forEach((node) => {
                if (node.children.length === 0 || node.tagName === 'LI') {
                  node.innerHTML = (node.textContent || '').replace(re, '<mark>$1</mark>');
                }
              });
            }
          });
        }

        searchInput.addEventListener('input', () => {
          clearTimeout(debounceId);
          const q = searchInput.value.trim();
          debounceId = setTimeout(() => runSearch(q), 150);
        });
      }

      const dropdown = document.getElementById('expedientes-dd') as HTMLDetailsElement | null;
      if (dropdown) {
        document.addEventListener('click', (e) => {
          if (dropdown.open && !dropdown.contains(e.target as Node)) {
            dropdown.open = false;
          }
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && dropdown.open) {
            dropdown.open = false;
          }
        });
      }
    </script>
  </body>
</html>
